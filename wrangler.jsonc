{
  "name": "cyber-job-acquisition-engine",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cyber-job-acquisition-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }
}